{
  "name": "scarab-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:dev": "bun run docs:gen && vitepress dev",
    "docs:build": "bun run docs:gen && vitepress build",
    "docs:deploy": "bun run docs:build && bunx gh-pages -d .vitepress/dist --nojekyll",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "lint": "vp lint",
    "check": "vp check",
    "docs:crates": "python3 gen-crate-map.py",
    "docs:gen": "bun run docs:crates",
    "docs:check": "bun run docs:gen && git diff --exit-code"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "vite-plus": "^1.3.0",
    "vitepress": "^1.6.3",
    "vitepress-plugin-llms": "^1.14.0"
  }
}
